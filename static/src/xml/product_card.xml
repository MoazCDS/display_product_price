<?xml version="1.0" encoding="UTF-8" ?>
<templates id="my_pos_productcard_inherit" xml:space="preserve">
    <t t-inherit="point_of_sale.ProductCard" t-inherit-mode="extension">
        <xpath expr="//article" position="inside">
            <div class="my-extra-info text-center w-100 mt-1">
                $ <t t-esc="this.productPrice"/>
            </div>
        </xpath>
    </t>
</templates>